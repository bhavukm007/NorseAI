APP_NAME=NorseAI API
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_API_V1_PREFIX=/api/v1
APP_DOCS_ENABLED=true
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_DATABASE_URL=postgresql+psycopg://norseai:norseai@localhost:5432/norseai
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_JWT_ALGORITHM=HS256
APP_JWT_ISSUER=norseai
APP_JWT_AUDIENCE=norseai-api
APP_OPERATOR_USERNAME=admin
APP_OPERATOR_PASSWORD=replace-with-a-strong-bootstrap-password
APP_ACCESS_TOKEN_MINUTES=15
APP_REFRESH_TOKEN_DAYS=7
APP_LOGIN_RATE_LIMIT=10
APP_AUTH_RATE_LIMIT=60
APP_FINANCIAL_RATE_LIMIT=60
APP_AUDIT_EXPORT_RATE_LIMIT=10
APP_RATE_LIMIT_WINDOW_SECONDS=60
APP_HSTS_MAX_AGE=31536000
APP_CSP_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'
APP_REDIS_URL=redis://localhost:6379/0
APP_OPA_URL=http://localhost:8181
VITE_API_BASE_URL=http://localhost:8000/api/v1

POSTGRES_DB=norseai
POSTGRES_USER=norseai
POSTGRES_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
OPERATOR_PASSWORD=replace-with-a-strong-bootstrap-password
JWT_ISSUER=norseai
JWT_AUDIENCE=norseai-api
